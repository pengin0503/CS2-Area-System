<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CS2ToolPath Condition="'$(CSII_TOOLPATH)' != ''">$(CSII_TOOLPATH)</CS2ToolPath>
    <CS2ToolPath Condition="'$(CS2ToolPath)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CS2ToolPath>
  </PropertyGroup>
  <Import Project="$(CS2ToolPath)/Mod.props" />
  <PropertyGroup>
    <AssemblyName>CS2AreaSystem</AssemblyName>
    <RootNamespace>CS2AreaSystem</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <TargetFramework Condition="'$(AreaApiCheck)' == 'true'">net8.0</TargetFramework>
    <ManagedPath Condition="'$(CSII_MANAGEDPATH)' != ''">$(CSII_MANAGEDPATH)</ManagedPath>
    <UnityModProjectPath Condition="'$(CSII_UNITYMODPROJECTPATH)' != ''">$(CSII_UNITYMODPROJECTPATH)</UnityModProjectPath>
    <ModPostProcessorPath Condition="'$(CSII_MODPOSTPROCESSORPATH)' != ''">$(CSII_MODPOSTPROCESSORPATH)</ModPostProcessorPath>
    <EntitiesVersion Condition="'$(CSII_ENTITIESVERSION)' != ''">$(CSII_ENTITIESVERSION)</EntitiesVersion>
    <EntityPackagePath Condition="'$(AreaSourceGeneratorPath)' != ''">$(AreaSourceGeneratorPath)</EntityPackagePath>
    <MSCORLIBPath Condition="'$(CSII_MSCORLIBPATH)' != ''">$(CSII_MSCORLIBPATH)</MSCORLIBPath>
    <LocalModsPath Condition="'$(CSII_LOCALMODSPATH)' != ''">$(CSII_LOCALMODSPATH)</LocalModsPath>
    <UserDataPath Condition="'$(CSII_USERDATAPATH)' != ''">$(CSII_USERDATAPATH)</UserDataPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Game;Colossal.Collections;Colossal.Core;Colossal.Logging;Colossal.Localization;Colossal.UI.Binding;Colossal.IO.AssetDatabase;Colossal.AssetPipeline;Unity.Entities;Unity.Collections;Unity.Mathematics;UnityEngine.CoreModule;UnityEngine.AudioModule;Unity.Burst;Colossal.Mathematics;Unity.TextMeshPro;Unity.InputSystem;UnityEngine.UI">
      <HintPath>$(ManagedPath)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(AreaApiCheck)' == 'true'">
    <Analyzer Remove="@(Analyzer)" />
    <Reference Remove="$(MSCORLIBPath)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="netstandard">
      <HintPath>$(ManagedPath)/netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Import Project="$(CS2ToolPath)/Mod.targets" Condition="'$(AreaApiCheck)' != 'true'" />
  <Target Name="BuildAreaApiCheckPaths" BeforeTargets="BeforeBuild" Condition="'$(AreaApiCheck)' == 'true'">
    <PropertyGroup><NeedBuild>false</NeedBuild></PropertyGroup>
    <Message Importance="high" Text="API-check profile: compiles against supplied game DLLs; no Unity postprocessing or game deployment. This output is not a playable mod." />
    <Error Condition="!Exists('$(ManagedPath)/Game.dll')" Text="Set CSII_MANAGEDPATH to the supplied 1.6.2f1 Managed DLL directory." />
    <!-- Every explicit game reference must exist in the target-version Managed set (no speculative assemblies). -->
    <Error Condition="'%(Reference.HintPath)' != '' AND !Exists('%(Reference.HintPath)')" Text="Game reference %(Reference.Identity) does not exist in the 1.6.2f1 Managed set: %(Reference.HintPath)" />
  </Target>
  <Target Name="BuildAreaUI" BeforeTargets="BeforeBuild">
    <PropertyGroup><AreaUIPath>$(MSBuildProjectDirectory)/../../UI</AreaUIPath></PropertyGroup>
    <Error Condition="'$(AreaApiCheck)' != 'true' AND !Exists('$(AreaUIPath)/node_modules/.bin/webpack')" Text="UI dependencies missing. Run npm ci in UI before deployment; stale UI will not be deployed." />
    <Message Condition="'$(AreaApiCheck)' == 'true' AND !Exists('$(AreaUIPath)/node_modules/.bin/webpack')" Importance="high" Text="UI dependencies missing: API-check skips UI; no deployment. Run npm ci in UI." />
    <Exec Condition="Exists('$(AreaUIPath)/node_modules/.bin/webpack')" Command="npm run build" WorkingDirectory="$(AreaUIPath)" />
  </Target>
  <Target Name="DeployAreaUI" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true'">
    <ItemGroup><AreaUIFiles Include="$(MSBuildProjectDirectory)/../../UI/build/**/*" /></ItemGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../UI/build/CS2AreaSystem.js')" Text="Current Area System UI output is missing; refusing stale deployment." />
    <Copy SourceFiles="@(AreaUIFiles)" DestinationFiles="@(AreaUIFiles->'$(DeployDir)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
